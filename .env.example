# ==============================================================================
# WorkSphere Platform - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="WorkSphere"

# Python FastAPI Analytics Service
ANALYTICS_SERVICE_PORT=8000
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_INTERNAL_API_KEY=ws_internal_sec_analytics_dev_key_2026
# Comma-separated browser origin allowlist for the analytics service.
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
# The Prisma schema and SQL migrations target PostgreSQL. The current Node API
# still uses its explicit in-memory demo store; it does not yet persist runtime
# application data through Prisma. Do not treat this URL as production-ready
# persistence until the repository layer is migrated.
DATABASE_URL=postgresql://worksphere:worksphere_password@localhost:5432/worksphere_db?schema=public
DIRECT_URL=postgresql://worksphere:worksphere_password@localhost:5432/worksphere_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_32_characters_minimum_key
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_32_characters_minimum_key
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=worksphere-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
STORAGE_MODE=local # Options: local | s3

# Email Service (Resend / Safe Mock Dev Provider)
EMAIL_PROVIDER=mock # Options: mock | resend
RESEND_API_KEY=
EMAIL_FROM=notifications@worksphere.local
APP_URL=http://localhost:3000

# Optional Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

STRIPE_SECRET_KEY=sk_test_placeholder_123456
STRIPE_WEBHOOK_SECRET=whsec_placeholder_123456
